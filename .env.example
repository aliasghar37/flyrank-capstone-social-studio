# ---------------------------------------------------------------------------
# Social Media Studio — environment template
#
# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is ignored by git. Never commit real tokens or webhook URLs.
# With only these placeholders, the system runs in zero-key mode:
#   AUTH_MODE=dev, LLM_PROVIDER=template, and mock adapters.
# A real adapter with missing or placeholder values is "unconfigured":
# scheduling to it returns 422 ADAPTER_NOT_CONFIGURED.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Data stores -----------------------------------------------------------
# Hosts are the Docker Compose service names. If you run the API outside Docker,
# replace "postgres" with "localhost" and "redis" with "localhost".
DATABASE_URL=postgresql://studio:studio@postgres:5432/studio
# Optional: owner role used only for migrations when the runtime role is restricted.
# MIGRATION_DATABASE_URL=postgresql://studio:studio@postgres:5432/studio
REDIS_URL=redis://redis:6379

# --- Authentication --------------------------------------------------------
# dev  = no keys; every request acts as dev_user (refused when NODE_ENV=production)
# clerk = verify Clerk session tokens
AUTH_MODE=dev
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# --- Generation ------------------------------------------------------------
# template = deterministic, no key required
# groq     = free-tier LLM; requires GROQ_API_KEY
LLM_PROVIDER=template
GROQ_API_KEY=gsk_replace_me
LLM_MODEL=llama-3.3-70b-versatile

# --- Real publishing targets ----------------------------------------------
# Telegram: create a bot with BotFather, add it as admin to your own channel.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=@your_channel
# Discord: own server -> channel -> Integrations -> Webhooks -> copy URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me

# --- Platform and adapter configuration -----------------------------------
PLATFORMS_CONFIG_PATH=./config/platforms.json
# Force every schedule through one adapter, e.g. mock_x (Probe 6 / CI).
# Leave empty in normal use.
FORCE_ADAPTER=

# --- Scheduling and reliability -------------------------------------------
PUBLISH_LEASE_SECONDS=60
MAX_PUBLISH_ATTEMPTS=5
RECONCILE_INTERVAL_SECONDS=30

# --- Test-only crash hooks ------------------------------------------------
# Keep false outside tests. When true, CRASH_AT can force a worker crash.
ENABLE_CRASH_HOOKS=false
# after_claim | after_mark | after_send
CRASH_AT=
