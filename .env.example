# Social Media Studio environment variables.
# Copy to .env (cp .env.example .env). Do not commit .env.
#
# The placeholder values are enough to run locally with dev auth,
# template generation and the mock adapters. Telegram and Discord are
# only available once their real values are set.

# Runtime
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Data stores
# Hostnames match the Docker Compose services. Use localhost when running on the host.
DATABASE_URL=postgresql://studio:studio@postgres:5432/studio
# Owner connection for migrations, only needed with db/roles.sql.
# MIGRATION_DATABASE_URL=postgresql://studio:studio@postgres:5432/studio
REDIS_URL=redis://redis:6379

# Authentication
# dev: all requests run as dev_user (not allowed in production)
# clerk: verify Clerk session tokens
AUTH_MODE=dev
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Generation
# template: no API key needed
# groq: needs GROQ_API_KEY
LLM_PROVIDER=template
GROQ_API_KEY=gsk_replace_me
LLM_MODEL=llama-3.3-70b-versatile

# Publishing targets
# Telegram bot (via BotFather), added as admin of the channel.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=@your_channel
# Discord channel webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me

# Platforms and adapters
PLATFORMS_CONFIG_PATH=./config/platforms.json
# Route every publish through one adapter, e.g. mock_x. Empty = use platforms.json.
FORCE_ADAPTER=

# Scheduling
PUBLISH_LEASE_SECONDS=60
MAX_PUBLISH_ATTEMPTS=5
RECONCILE_INTERVAL_SECONDS=30

# Crash hooks (tests only)
ENABLE_CRASH_HOOKS=false
# after_claim | after_mark | after_send
CRASH_AT=

# Docker Compose host ports
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=4000
WEB_HOST_PORT=3000
